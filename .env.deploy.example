# Copie para .env.deploy e preencha. NUNCA versione o .env.deploy.

FTP_HOST=
FTP_USER=
FTP_PASS=
# Document root do subdomínio no cPanel. ATENÇÃO: o deploy usa
# `mirror --delete`, então um caminho errado apaga o conteúdo do destino.
FTP_DIR=
SITE_URL=

# FTPS. A HostGator aceita, mas com certificado autoassinado — por isso a
# verificação fica desligada. Deixe FTP_SSL_ALLOW=false só se o servidor
# recusar TLS.
FTP_SSL_ALLOW=true
FTP_SSL_VERIFY=false
