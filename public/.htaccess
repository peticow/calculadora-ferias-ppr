# Calculadora Férias & PPR — HostGator / Apache
# Este arquivo mora em public/ e o Vite o copia para dist/ a cada build,
# de modo que o deploy sempre o envia junto.

# ─────────────────────────── HTTPS obrigatório ───────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Não mexer no desafio do AutoSSL: se ele for redirecionado, a renovação quebra.
  RewriteRule ^\.well-known/ - [L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ───────────────────────────── Cache ─────────────────────────────
<IfModule mod_headers.c>
  # parametros.json é o arquivo que se atualiza em janeiro SEM recompilar.
  # Se ficar em cache, o usuário simula o ano inteiro com a tabela antiga.
  <Files "parametros.json">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Expires
    Header set Pragma "no-cache"
  </Files>

  # index.html também sem cache: é ele que aponta para os assets novos.
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header unset Expires
  </Files>

  # Assets com hash no nome nunca mudam de conteúdo: cache de 1 ano.
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # O cache longo acima não pode alcançar os dois arquivos sem hash.
  <FilesMatch "^(index\.html|parametros\.json)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType application/json      "access plus 0 seconds"
</IfModule>

# ─────────────────────────── Compressão ───────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ───────────────────────────── SPA ─────────────────────────────
# Uma página só: qualquer caminho que não seja arquivo real cai no index.html.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ─────────────────────── Tipos e cabeçalhos ───────────────────────
<IfModule mod_mime.c>
  AddType application/json .json
  AddCharset UTF-8 .html .css .js .json
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>

Options -Indexes
