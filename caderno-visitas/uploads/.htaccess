# Fotos: aqui só se servem imagens. Nada é executado.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

# Lista branca: só arquivos com nome gerado pelo servidor e extensão de imagem.
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^[a-f0-9]{24}\.(jpg|png|webp|mp4|mov|webm|3gp)$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^[a-f0-9]{24}\.(jpg|png|webp|mp4|mov|webm|3gp)$">
    Allow from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
